{
  "equivalentPaths": [
    [
      "config/skills/",
      "config/vendored-skills/"
    ]
  ],
  "suites": {
    "scenario": {
      "runner": "scenario",
      "paths": [
        "config/CLAUDE.global.md",
        "config/skill-overlays/**",
        "config/hooks/skill_overlay.py",
        "config/hooks/lifecycle_default.py",
        "eval/scenarios.json",
        "eval/clauses.json",
        "eval/criteria.json"
      ],
      "harness": [
        "eval/run_eval.py"
      ],
      "compareBase": true,
      "smoke": [
        "S-01",
        "S-02"
      ]
    },
    "rubric": {
      "runner": "rubric",
      "paths": [
        "config/CLAUDE.global.md",
        "eval/criteria.json"
      ],
      "harness": [
        "eval/run_eval.py"
      ]
    },
    "hook-overlay": {
      "runner": "hook-overlay",
      "paths": [
        "config/hooks/skill_overlay.py",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/settings.fragment.json",
          "pointer": "/hooks/PostToolUse"
        },
        {
          "file": "config/settings.fragment.json",
          "pointer": "/hooks/UserPromptExpansion"
        }
      ],
      "harness": [
        "eval/hook_harness.py",
        "eval/run_eval.py"
      ]
    },
    "hook-merge": {
      "runner": "hook-merge",
      "paths": [
        "config/hooks/merge_confirm.py",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/settings.fragment.json",
          "pointer": "/hooks/PreToolUse"
        }
      ],
      "harness": [
        "eval/hook_harness.py",
        "eval/run_eval.py"
      ]
    },
    "hook-session-start": {
      "runner": "hook-session-start",
      "paths": [
        "config/hooks/lifecycle_default.py",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/settings.fragment.json",
          "pointer": "/hooks/SessionStart"
        },
        {
          "file": "config/settings.fragment.json",
          "pointer": "/hooks/SubagentStart"
        }
      ],
      "harness": [
        "eval/session_harness.py",
        "eval/hook_harness.py",
        "eval/run_eval.py"
      ]
    },
    "lifecycle-trigger": {
      "runner": "script",
      "script": "config/skills/github-issue-lifecycle/evals/run_trigger_evals.py",
      "paths": [
        "config/skills/github-issue-lifecycle/evals/trigger-evals.json"
      ],
      "selectors": [
        {
          "file": "config/skills/github-issue-lifecycle/SKILL.md",
          "part": "description"
        }
      ],
      "harness": [
        "config/skills/github-issue-lifecycle/evals/run_trigger_evals.py",
        "config/skills/github-issue-lifecycle/evals/run_behaviour_evals.py"
      ]
    },
    "lifecycle-behaviour": {
      "runner": "script",
      "script": "config/skills/github-issue-lifecycle/evals/run_behaviour_evals.py",
      "paths": [
        "config/skills/github-issue-lifecycle/evals/evals.json",
        "config/skills/github-issue-lifecycle/scripts/**",
        "config/skills/github-issue-lifecycle/references/**",
        "config/skills/github-issue-lifecycle/assets/**"
      ],
      "selectors": [
        {
          "file": "config/skills/github-issue-lifecycle/SKILL.md",
          "part": "body"
        }
      ],
      "harness": [
        "config/skills/github-issue-lifecycle/evals/run_behaviour_evals.py",
        "config/skills/github-issue-lifecycle/evals/fake_gh.py"
      ]
    },
    "jira-ticket-lifecycle-trigger": {
      "runner": "script",
      "script": "config/skills/jira-ticket-lifecycle/evals/run_trigger_evals.py",
      "paths": [
        "config/skills/jira-ticket-lifecycle/evals/trigger-evals.json"
      ],
      "selectors": [
        {
          "file": "config/skills/jira-ticket-lifecycle/SKILL.md",
          "part": "description"
        }
      ],
      "harness": [
        "config/skills/jira-ticket-lifecycle/evals/run_trigger_evals.py",
        "config/skills/jira-ticket-lifecycle/evals/run_behaviour_evals.py"
      ]
    },
    "jira-ticket-lifecycle-behaviour": {
      "runner": "script",
      "script": "config/skills/jira-ticket-lifecycle/evals/run_behaviour_evals.py",
      "paths": [
        "config/skills/jira-ticket-lifecycle/evals/evals.json",
        "config/skills/jira-ticket-lifecycle/scripts/**",
        "config/skills/jira-ticket-lifecycle/references/**",
        "config/skills/jira-ticket-lifecycle/assets/**"
      ],
      "selectors": [
        {
          "file": "config/skills/jira-ticket-lifecycle/SKILL.md",
          "part": "body"
        }
      ],
      "harness": [
        "config/skills/jira-ticket-lifecycle/evals/run_behaviour_evals.py",
        "config/skills/jira-ticket-lifecycle/evals/fake_cli.py"
      ]
    },
    "plain-prose-trigger": {
      "runner": "trigger",
      "skill": "plain-prose",
      "cases": "config/skills/plain-prose/evals/trigger-evals.json",
      "paths": [
        "config/skills/plain-prose/evals/trigger-evals.json",
        "config/skills/*/SKILL.md",
        "config/vendored-skills/*/SKILL.md",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/skills/plain-prose/SKILL.md",
          "part": "description"
        }
      ],
      "harness": [
        "eval/skill_evals.py",
        "eval/run_eval.py"
      ],
      "smoke": [
        1,
        15
      ]
    },
    "plain-prose-behaviour": {
      "runner": "cold-reader",
      "skill": "plain-prose",
      "cases": "config/skills/plain-prose/evals/behaviour-evals.json",
      "paths": [
        "config/skills/plain-prose/evals/behaviour-evals.json",
        "config/skills/plain-prose/scripts/**",
        "config/skills/plain-prose/references/**",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/skills/plain-prose/SKILL.md",
          "part": "body"
        }
      ],
      "harness": [
        "eval/skill_evals.py",
        "eval/run_eval.py"
      ],
      "smoke": [
        "rewrite-review-note"
      ]
    },
    "writing-docs-trigger": {
      "runner": "doc-trigger",
      "skill": "writing-docs",
      "cases": "config/skills/writing-docs/evals/trigger-evals.json",
      "companions": [
        "plain-prose"
      ],
      "paths": [
        "config/skills/writing-docs/evals/trigger-evals.json",
        "config/skills/*/SKILL.md",
        "config/vendored-skills/*/SKILL.md",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/skills/writing-docs/SKILL.md",
          "part": "description"
        },
        {
          "file": "config/skills/plain-prose/SKILL.md",
          "part": "description"
        }
      ],
      "harness": [
        "eval/doc_evals.py",
        "eval/skill_evals.py",
        "eval/run_eval.py"
      ],
      "smoke": [
        0,
        21
      ]
    },
    "writing-docs-behaviour": {
      "runner": "doc-reader",
      "skill": "writing-docs",
      "cases": "config/skills/writing-docs/evals/behaviour-evals.json",
      "companions": [
        "plain-prose"
      ],
      "paths": [
        "config/skills/writing-docs/evals/behaviour-evals.json",
        "config/skills/writing-docs/scripts/**",
        "config/skills/writing-docs/references/**",
        "eval/criteria.json"
      ],
      "selectors": [
        {
          "file": "config/skills/writing-docs/SKILL.md",
          "part": "body"
        }
      ],
      "harness": [
        "eval/doc_evals.py",
        "eval/skill_evals.py",
        "eval/run_eval.py"
      ],
      "smoke": [
        "rewrite-how-to"
      ]
    }
  }
}
