.ruff_cache/
.coverage
htmlcov/

# Local working state
/.claude/worktrees/
# The excluded-terms list belongs in ~/.config/claude-config/; never commit a copy.
deny-terms

# Never-versioned paths. These mirror the deny-list in tools/git_hooks.py, which
# pre-commit enforces; tests/test_git_hooks.py checks that every entry is here.
.credentials.json
*.jsonl
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
.claude.json
/history*
/config/history*
/daemon.*
/config/daemon.*
/*.log
/config/*.log
/gh-pr-status-cache.json
/config/gh-pr-status-cache.json
/.last-cleanup
/config/.last-cleanup
/settings.json
/config/settings.json
/projects/
/config/projects/
/sessions/
/config/sessions/
/session-env/
/config/session-env/
/jobs/
/config/jobs/
/tasks/
/config/tasks/
/todos/
/config/todos/
/shell-snapshots/
/config/shell-snapshots/
/file-history/
/config/file-history/
/paste-cache/
/config/paste-cache/
/cache/
